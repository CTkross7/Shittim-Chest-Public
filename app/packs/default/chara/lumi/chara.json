{
  "id": "lumi",
  "name": "루미",
  "affil": "기본 팩 · 임시 캐릭터",
  "color": "#4a9be8",
  "icon": "icon.svg",
  "face0": "normal",
  "breath": 3.6,
  "sway": 0.6,
  "bob": 0.45,
  "tap": ["hophop", "jump", "nod"],
  "head": ["nod", "wiggle"],
  "talkEvery": 60,
  "poses": {
    "stand": {
      "dir": "poses/stand/",
      "w": 600, "h": 900,
      "layers": {
        "body": "body.svg",
        "blink": "blink.svg",
        "mouth": "mouth.svg",
        "faces": {
          "normal": "face/normal.svg", "smile": "face/smile.svg", "surprised": "face/surprised.svg", "sad": "face/sad.svg",
          "angry": "face/angry.svg", "shy": "face/shy.svg", "sleep": "face/sleep.svg", "think": "face/think.svg"
        }
      },
      "anchor": { "head": [0.5, 0.37], "emo": [0.82, 0.15], "neck": 0.57, "cx": 0.5 }
    }
  },
  "bg": {
    "morning": ["room_day"], "day": ["room_day"], "evening": ["room_day"], "night": ["room_night"]
  },
  "lines": {
    "in": [
      { "t": "어서 오세요, [USERNAME] 선생님! 오늘도 같이 힘내요.", "f": "smile" },
      { "t": "기다리고 있었어요! 필요한 앱이 있으면 언제든 불러 주세요.", "f": "smile" },
      { "t": "선생님, 오셨어요? 홈 화면은 깔끔하게 정리해 뒀어요.", "f": "normal" }
    ],
    "talk": [
      { "t": "네, 부르셨어요?", "f": "normal" },
      { "t": "에헤헤, 간지러워요!", "f": "shy" },
      { "t": "오늘 할 일은 미션 목록에 정리해 뒀어요.", "f": "smile" },
      { "t": "앗, 깜짝이야…! 갑자기 누르시면 놀라잖아요.", "f": "surprised" },
      { "t": "음… 선생님, 혹시 심심하신 건가요?", "f": "think" },
      { "t": "저는 아직 임시 모습이에요. 언젠가 새 옷을 입게 될지도 몰라요!", "f": "smile" },
      { "t": "선생님, 너무 무리하지 마세요.", "f": "sad" },
      { "t": "자꾸 찌르시면… 저도 화낼 거예요!", "f": "angry", "only": "workTap", "poke": 4 },
      { "t": "…알겠어요. 선생님은 그냥 저랑 놀고 싶으신 거죠?", "f": "shy", "only": "workTap", "poke": 5 }
    ],
    "cafe": [
      { "t": "흥흥~♪ 오늘은 날씨가 어떨까요.", "f": "smile" },
      { "t": "앱 아이콘 정리… 정리… 이 정도면 됐겠죠?", "f": "think" },
      { "t": "선생님이 안 계시니까 조금 조용하네요.", "f": "normal" },
      { "t": "하아암… 아, 졸면 안 되는데…", "f": "sleep" }
    ]
  },
  "situ": {
    "dawn": [{ "t": "선생님, 아직 안 주무셨어요? 곧 해가 뜨겠어요…!", "f": "surprised", "e": "Sweat" }],
    "morning": [{ "t": "좋은 아침이에요, {name} 선생님! 오늘 하루도 시작해 볼까요?", "f": "smile", "e": "Twinkle" }],
    "noon": [{ "t": "점심시간이에요! 맛있는 거 드시고 오세요♪", "f": "smile", "e": "Music" }],
    "afternoon": [{ "t": "오후도 힘내요, 선생님! 제가 응원할게요.", "f": "smile", "e": "Twinkle" }],
    "evening": [{ "t": "오늘 하루도 수고 많으셨어요, {name} 선생님!", "f": "smile", "e": "Heart" }],
    "night": [{ "t": "밤이 깊었어요. 슬슬 쉬셔야죠, 선생님.", "f": "sad", "e": "Sweat" }],
    "weekend": [{ "t": "오늘은 주말이에요! 선생님도 조금은 쉬셔야 해요♪", "f": "smile", "e": "Music" }],
    "monday": [{ "t": "월요일이에요…! 이번 주도 같이 힘내 봐요!", "f": "surprised", "e": "Exclaim" }],
    "back_long": [{ "t": "선생님! 기다리고 있었어요!", "f": "smile", "e": "Exclaim" }],
    "back_day": [{ "t": "선생님…! 하루 넘게 안 오셔서 걱정했잖아요.", "f": "sad", "e": "Sad" }],
    "charge_on": [{ "t": "충전 시작! 힘이 들어오는 느낌이에요~♪", "f": "smile", "e": "Twinkle" }],
    "charge_off": [{ "t": "충전 끝! 배터리 {n}%예요.", "f": "normal", "e": "Respond" }],
    "full": [{ "t": "배터리 가득! 100%예요, 선생님!", "f": "smile", "e": "Twinkle" }],
    "low": [{ "t": "선생님, 배터리가 {n}%밖에 안 남았어요……!", "f": "surprised", "e": "Sweat" }],
    "app_added": [{ "t": "새 앱 '{app}'이(가) 설치됐어요! 서랍에 넣어 둘게요.", "f": "surprised", "e": "Exclaim" }],
    "app_removed": [{ "t": "'{app}'을(를) 지우셨네요. 정리 완료!", "f": "normal", "e": "Respond" }],
    "updated": [{ "t": "새 버전으로 업데이트했어요, 선생님!", "f": "smile", "e": "Twinkle" }],
    "mission_done": [{ "t": "'{title}' 완료! 잘하셨어요, 선생님!", "f": "smile", "e": "Twinkle" }],
    "mission_all": [{ "t": "오늘의 미션 전부 완료! 역시 {name} 선생님이에요!", "f": "smile", "e": "Heart" }]
  }
}
